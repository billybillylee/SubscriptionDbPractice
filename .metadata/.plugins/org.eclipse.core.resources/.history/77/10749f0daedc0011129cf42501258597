<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
	
		<settings>
			<setting name="logImpl" value="STDOUT_LOGGING" />
			<setting name="mapUnderscoreToCamelCase" value="true" />
		</settings>
		<typeAliases>
			<typeAlias type ="com.kh.subs.model.dto.SubscriptionDto" alias="sub" />
		</typeAliases>
		<environments default="development">
			<enviroment id="development">
				<transactionManager type="MANAGED" />
				<dataSource type="POOLED">
					<property name="driver" value="oralce.jdbc.driver.OracleDriver" />
					<property name="url" value="jdbc:oralce:thin:@127.0.0.1:1521/XEPDB1 />
						
				</dataSource>
			</enviroment>
				</environments>
</configuration>