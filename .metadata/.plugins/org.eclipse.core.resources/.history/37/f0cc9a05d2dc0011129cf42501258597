<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="subsMapper">
	<select id="selectAll"
	        resultType="sub">
	     <include refid="subColumns" />
	        ORDER
	           BY
	              SUB_NO
	</select>
	
	<insert id="insertSub"
			parameterType="sub">
	  INSERT
	    INTO
	         SUBSCRIPTION
	  VALUES 
	         (
	          SEQ_SUB_NO.NEXTVAL
	        , #{subName}
	        , #{monthlyFee}
	        , #{paymentDay}
	        , #{category}
	         )			
	</insert>
	
	<select id="selectOne"
			parameterType="_int"
			resultType="sub">
		<include refid="subColunms" />	
  		 WHERE
 		       SUB_NO = #{subNo}
	</select>
	
	<update id="updateFee">
		UPDATE
		       SUBSCRIPTION
		   SET 
		       MONTHLY_FEE = #{monthlyFee}
		 WHERE
		       SUB_NO = #{subNo}
	</update>
	
	<delete id="deleteSub">
		DELETE
		  FROM
		       SUBSCRIPTION
		 WHERE
		       SUB_NO = #{subNo}
	</delete>
	
	<sql id="subColumns">
		<include refid="subColumns" />
		 FROM
		      SUBSCRIPTION
	</sql>
	
	<select id="selectAll"
			resultType="sub">
	   <include refid="subCoulumns" />
	   ORDER
	   	  BY
	   	     SUB_NO
	</select>
</mapper>