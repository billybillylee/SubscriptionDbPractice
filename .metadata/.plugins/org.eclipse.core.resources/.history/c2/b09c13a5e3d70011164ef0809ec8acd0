package com.kh.start.ward;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.Scanner;

public class InsertRun {

	public static void main(String[] args) {
		// Java 코드를 작설해서 ward 테이블에 한 행 insert 해보기.
		/*
		 * 1. 디비버 실행(클라이언트 프로르램)
		 * 
		 * 2. 접속하기(콘센트) 누름
		 * 
		 * 3. 오라클 데이터베이스 선택
		 * 
		 * 4. 아이피 주소, 포트 번호, 사용자이름, 비빌먼호를 가지고 연결
		 * 
		 * 5. 새로 sql 편집기
		 * 
		 * 6. INSERT 문 작성 => INSERT INTO WARD VALUES('값', '값, '값', '값')
		 * 
		 * 7. sql문 실행
		 * 
		 * 8. updateRows :
		 * 
		 * commit
		 * 
		 * 
		 */
		// 0) 필요한 변수 선언
		Connection conn = null;
		Statement stmt = null;
		
		int result = 0;
		// JDBC - Java DataBase Connectivity
		// 라이브러리(함수모음집)

		//String sql = "INSERT INTO WARD VALUES('W7', 'KH병동', '특실', 4)";
		Scanner sc = new Scanner(System.in);
		System.out.print("커피명을 입력해주세요 > ");
		String coffeeName = sc.nextLine();
		/*
		String sql = "INSERT " 
					 + "INTO "
					 	  + "COFFEE "
					 + "VALUES "
					 	+  "("
					 	+ "SEQ_COFFEE.NEXTVAL"
					 + ", '" + coffeeName + "'"
					 + ", SYSDATE)"; */
		StringBuilder sb = new StringBuilder();
		sb.append("INSERT  ");
		sb.append("  INTO  ");
		sb.append("        COFFEE ");
		sb.append("VALUES  ");
		sb.append("        (");
		sb.append("        SEQ_COFFEE.NEXTVAL");
		sb.append("      , '" + coffeeName + "'");
		sb.append("      , SYSDATE");
		sb.append("        )");
		String sql = sb.toString();
		System.out.println(sql);
		
		// 오라클 DBMS에다 작업을 하겠다!! -> 등록하는 과정 필요
		// [Reflection] 객체를 생성하지 않고 객체의 정보를 빼오는 기술 / 동적으로 클래스 로드
		// 1)JDBC Driver 등록 -> ORACLE -> ojdbc.jar
		// 어디서 오류났는지 확인하는법
		// 1. 오타가 났는지 확인.
		// 2. 프로젝트에 ojdbc.jar 파일 추가했는지 확인해보기.
		// 3. SQL문을 문법적으로 잘못적었는지 확인해보기.
		try {
			Class.forName("oracle.jdbc.driver.OracleDriver");
			System.out.println("Driver 등록성공!");
			// 2) DB서버랑 연결(IP주소, PORT번호, 사용자이름, 비밀번호)

			conn = DriverManager.getConnection("jdbc:oracle:thin:@127.0.0.1:1521/XEPDB1", "HOSPITAL", "oracle");
			// 위에 적힌건 그냥 외워라!
			System.out.println("DB 연결 성공!");

			stmt = conn.createStatement();
			System.out.println("Statement 객체 생성!");

			result = stmt.executeUpdate(sql);
			System.out.println("SQL문 실행성공!");

		} catch (ClassNotFoundException e) {
			e.printStackTrace();
		} catch (SQLException e) {
			e.printStackTrace();
		} finally {
			try {
				stmt.close();
				conn.close();
			} catch (SQLException e) {
				e.printStackTrace();
			}
		}

	}
}
